{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/gitoido-mc/Kotlin-Multiloader-Template"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "adapter": "kotlin",
                "value": "com.example.examplemod.fabric.ExampleModFabric::init"
            }
        ]
    },
    "mixins": [
        "${mod_id}.common.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "java": ">=${java_version}",
        "minecraft": "${minecraft_version}",
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-language-kotlin": ">=${fabric_kotlin_version}",
        "fabric-api": "*"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  